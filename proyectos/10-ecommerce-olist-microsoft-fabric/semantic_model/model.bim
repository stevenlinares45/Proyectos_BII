          {
            "name": "freight_value",
            "dataType": "decimal",
            "sourceColumn": "freight_value",
            "summarizeBy": "none"
          },
          {
            "name": "total_linea",
            "dataType": "decimal",
            "sourceColumn": "total_linea",
            "summarizeBy": "none"
          },
          {
            "name": "dias_entrega",
            "dataType": "int64",
            "sourceColumn": "dias_entrega",
            "summarizeBy": "none"
          },
          {
            "name": "entrega_a_tiempo",
            "dataType": "boolean",
            "sourceColumn": "entrega_a_tiempo",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_ventas",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fact_ventas",
              "schemaName": "dwh",
              "expressionSource": "DatabaseQuery"
            }
          }
        ],
        "measures": [
          {
            "name": "Ventas",
            "expression": "SUM(fact_ventas[price])",
            "formatString": "#,0.00"
          },
          {
            "name": "Flete",
            "expression": "SUM(fact_ventas[freight_value])",
            "formatString": "#,0.00"
          },
          {
            "name": "Pedidos",
            "expression": "DISTINCTCOUNT(fact_ventas[order_id])",
            "formatString": "#,0"
          },
          {
            "name": "Clientes unicos",
            "expression": "COUNTROWS(SUMMARIZE(fact_ventas, dim_cliente[customer_unique_id]))",
            "formatString": "#,0"
          },
          {
            "name": "Ticket Medio",
            "expression": "DIVIDE([Ventas], [Pedidos])",
            "formatString": "#,0.00"
          },
          {
            "name": "% Entrega a Tiempo",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(fact_ventas), fact_ventas[entrega_a_tiempo] = TRUE()), CALCULATE(COUNTROWS(fact_ventas), NOT ISBLANK(fact_ventas[entrega_a_tiempo])))",
            "formatString": "0.0%"
          },
          {
            "name": "Dias Entrega Prom",
            "expression": "AVERAGE(fact_ventas[dias_entrega])",
            "formatString": "0.0"
          },
          {
            "name": "Ventas YTD",
            "expression": "TOTALYTD([Ventas], dim_fecha[fecha])",
            "formatString": "#,0.00"
          },
          {
            "name": "Ventas Anio Anterior",
            "expression": "CALCULATE([Ventas], SAMEPERIODLASTYEAR(dim_fecha[fecha]))",
            "formatString": "#,0.00"
          },
          {
            "name": "Crecimiento YoY",
            "expression": "DIVIDE([Ventas] - [Ventas Anio Anterior], [Ventas Anio Anterior])",
            "formatString": "0.0%"
          }
        ]
      }
    ],
